Servo myServo;

#define RAIN_PIN 35
#define SERVO_PIN 27
#define SMOKE_SENSOR_PIN 32
#define BUZZER_RELAY_PIN 25

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

#define DHTPIN 4
#define DHTTYPE DHT22
DHT dht(DHTPIN, DHTTYPE);
RTC_DS3231 rtc;

#define RELAY_PIN 26
#define SOIL_PIN 34

char ssid[] = "Mouse Love Rice";
char pass[] = "AEngohuu@991";

float t = 0, h = 0;
int soilValue = 0;
int soilPercent = 0;
bool autoMode = false;
bool timerMode = false;
bool manualPump = false;
bool manualServo = false;
bool smokeDetected = false;
bool buzzerActive = false;
unsigned long buzzerStartTime = 0;
int isRaining = 0;

char message[] = "Ngo Huu Duy - GCS200881";
char daysOfTheWeek[7][4] = {"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"};
char monthsOfTheYear[12][3] = {"01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"};

const unsigned char temp_arr[] PROGMEM = {
  0x00, 0x00, 0x01, 0x80, 0x02, 0x40, 0x03, 0x40,
  0x03, 0x40, 0x03, 0x40, 0x03, 0x40, 0x03, 0x40,
  0x03, 0xc0, 0x03, 0xc0, 0x05, 0xe0, 0x07, 0xe0,
  0x07, 0xe0, 0x07, 0xe0, 0x03, 0xc0, 0x00, 0x00
};

const unsigned char humi_arr[] PROGMEM = {
  0x00, 0x00, 0x00, 0x00, 0x01, 0x80, 0x03, 0xc0,
  0x03, 0xc0, 0x07, 0xe0, 0x07, 0xe0, 0x0e, 0xf0,
  0x0f, 0x70, 0x1f, 0xf8, 0x1e, 0xf8, 0x0f, 0x70,
  0x0f, 0xf0, 0x07, 0xe0, 0x00, 0x00, 0x00, 0x00
};

int x, minX;
BlynkTimer timer;

void readSensors() {
  float temp = dht.readTemperature();
  float humi = dht.readHumidity();
  if (!isnan(temp)) t = temp;
  if (!isnan(humi)) h = humi;

  soilValue = analogRead(SOIL_PIN);
  soilPercent = map(soilValue, 4095, 0, 0, 100);

  isRaining = (digitalRead(RAIN_PIN) == LOW) ? 1 : 0;
  smokeDetected = (digitalRead(SMOKE_SENSOR_PIN) == LOW);

  Serial.print("Soil: "); Serial.print(soilPercent);
  Serial.print(" %, Temp: "); Serial.print(t);
  Serial.print(" C, Humidity: "); Serial.print(h);
  Serial.print(" %, Rain: "); Serial.println(isRaining ? "☔️ Rain" : "🌤 Sunny");

  if (Blynk.connected()) {
    Blynk.virtualWrite(V4, soilPercent);
    Blynk.virtualWrite(V5, (int)h);
    Blynk.virtualWrite(V6, (int)t);
    Blynk.virtualWrite(V7, isRaining);
  }
}

void controlBuzzer() {
  int currentSmoke = digitalRead(SMOKE_SENSOR_PIN);
  Serial.println("SMOKE = " + String(currentSmoke));

  // Nếu PHÁT HIỆN KHÓI (LOW) và còi chưa được bật
  if (currentSmoke == LOW && !buzzerActive) {
    digitalWrite(BUZZER_RELAY_PIN, LOW);  // bật còi
    buzzerStartTime = millis();
    buzzerActive = true;
    Serial.println("🚨 Phát hiện khói! Bật còi.");
  }

  // Nếu còi đang bật và đã quá 5 giây → tắt còi
  if (buzzerActive && millis() - buzzerStartTime >= 5000) {
    digitalWrite(BUZZER_RELAY_PIN, HIGH); // tắt còi
    buzzerActive = false;
    Serial.println("🔕 Tắt còi sau 5 giây.");
  }

  // Nếu KHÔNG CÒN KHÓI thì đảm bảo tắt còi
  if (currentSmoke == HIGH && buzzerActive) {
    digitalWrite(BUZZER_RELAY_PIN, HIGH);
    buzzerActive = false;
    Serial.println("🟢 Không còn khói. Còi tắt.");
  }
}

void scrollMessage() {
  x--;
  if (x < minX) x = display.width();
}

void drawDisplay() {
  display.clearDisplay();
  DateTime now = rtc.now();
  display.setCursor(0, 0);
  display.printf("%s, %02d/%02d/%04d %02d:%02d",
    daysOfTheWeek[now.dayOfTheWeek()], now.day(), now.month(), now.year(), now.hour(), now.minute());
  display.setCursor(x, 10);
  display.print(message);
  display.setCursor(0, 20);
  display.printf("Air Temp: %.1f C", t);
  display.drawBitmap(100, 20, temp_arr, 16, 16, 1);
  display.setCursor(0, 30);
  display.printf("Humidity: %.1f %%,", h);
  display.drawBitmap(100, 30, humi_arr, 16, 16, 1);
  display.setCursor(0, 40);
  display.printf("Soil: %d%%", soilPercent);
  display.setCursor(0, 50);
  display.printf("Pump: %s", digitalRead(RELAY_PIN) ? "ON" : "OFF");
  display.setCursor(70, 50);
  display.printf("W: %s", isRaining ? "Rain" : "Sunny");
  display.display();
}

void controlPump() {
  DateTime now = rtc.now();
  int hour = now.hour();
  int minute = now.minute();

  if (manualPump) {
    digitalWrite(RELAY_PIN, HIGH);
    delay(200);
  } else if (autoMode) {
    if (soilPercent < 40 && h < 80 && t >= 15 && t <= 40) {
      digitalWrite(RELAY_PIN, HIGH);
      delay(200);
    } else {
      digitalWrite(RELAY_PIN, LOW);
    }
  } else if (timerMode) {
    if ((hour == 6 || hour == 17) && minute < 5) {
      if (soilPercent < 40 && h < 80 && t >= 15 && t <= 40) {
        digitalWrite(RELAY_PIN, HIGH);
        delay(200);
      } else {
        digitalWrite(RELAY_PIN, LOW);
      }
    } else {
      digitalWrite(RELAY_PIN, LOW);
    }
  } else {
    digitalWrite(RELAY_PIN, LOW);
  }

  // Điều khiển servo theo mưa
  if (manualServo) {
    myServo.write(90);  // Bật nút Blynk → đóng nắp
  } else {
    if (isRaining) {
      myServo.write(90);  // Mưa → đóng nắp
    } else {
      myServo.write(0);   // Không mưa → mở nắp
   }
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, LOW);
  pinMode(SOIL_PIN, INPUT);
  pinMode(RAIN_PIN, INPUT);

  pinMode(SMOKE_SENSOR_PIN, INPUT);
  pinMode(BUZZER_RELAY_PIN, OUTPUT);
  digitalWrite(BUZZER_RELAY_PIN, HIGH);

  dht.begin();
  rtc.begin();

  myServo.setPeriodHertz(50); // Tần số 50Hz tiêu chuẩn
  myServo.attach(SERVO_PIN, 500, 2400); // giới hạn xung cho SG90
  myServo.write(0); // Góc ban đầu

  WiFi.begin(ssid, pass);
  WiFi.setAutoReconnect(true);
  WiFi.persistent(true);
  while (WiFi.status() != WL_CONNECTED) {
    delay(100);
    Serial.print(".");
  }

  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("SSD1306 allocation failed"));
    while (1);
  }

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setTextWrap(false);

  x = display.width();
  minX = -6 * strlen(message);

  timer.setInterval(10000L, readSensors);
  timer.setInterval(20L, scrollMessage);
  timer.setInterval(100L, drawDisplay);
  timer.setInterval(1000L, controlBuzzer);
}

void loop() {
  Blynk.run();
  timer.run();
  controlPump();
}

BLYNK_CONNECTED() {
  timer.setTimeout(2000L, []() {
    Blynk.syncVirtual(V0, V1, V3);
    Blynk.virtualWrite(V4, soilPercent);
    Blynk.virtualWrite(V5, (int)h);
    Blynk.virtualWrite(V6, (int)t);
    Blynk.virtualWrite(V7, isRaining);
  });
}

BLYNK_WRITE(V0) {
  autoMode = param.asInt();
  if (autoMode) {
    timerMode = false;
    manualPump = false;
  }
}

BLYNK_WRITE(V1) {
  timerMode = param.asInt();
  if (timerMode) {
    autoMode = false;
    manualPump = false;
  }
}

BLYNK_WRITE(V3) {
  manualPump = param.asInt();
  if (manualPump) {
    autoMode = false;
    timerMode = false;
  }
}

BLYNK_WRITE(V8) {
  manualServo = param.asInt();
}